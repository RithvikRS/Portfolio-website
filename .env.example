# Copy to .env locally. Never commit real credentials.
HOST=127.0.0.1
PORT=4173
PUBLIC_ORIGIN=http://127.0.0.1:4173
NODE_ENV=development

# Set true only behind a trusted reverse proxy that overwrites X-Real-IP.
TRUST_PROXY=false
# Additional exact proxy IPs, comma-separated. Loopback is trusted when enabled.
# Docker production Compose supplies Caddy's private IP automatically.
TRUSTED_PROXY_IPS=

# Use your provider's SMTP credentials / app password (not your normal login password).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# One email address per setting. FROM must be permitted by your SMTP provider.
CONTACT_FROM=
CONTACT_TO=
