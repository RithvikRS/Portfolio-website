:80 {
    @monitoring host uptime.144.24.135.201.sslip.io
    redir @monitoring https://uptime.144.24.135.201.sslip.io{uri} permanent
    @notifications host {$NTFY_DOMAIN}
    redir @notifications https://{$NTFY_DOMAIN}{uri} permanent
    redir https://{$DOMAIN}{uri} permanent
}

# Separate host-only sessions avoid sharing cookies across sslip.io tenants.
(private_identity) {
    request_header -Remote-User
    request_header -Remote-Groups
    request_header -Remote-Email
    request_header -Remote-Name
}

{$NTFY_DOMAIN} {
    import private_identity
    handle /auth/* {
        reverse_proxy auth:9091
    }
    # Only protocol endpoints bypass browser SSO. ntfy still enforces its ACLs.
    @api {
        path /v1/* /*/json /*/sse /*/raw /*/ws /*/auth
    }
    handle @api {
        reverse_proxy ntfy:8080 {
            flush_interval -1
        }
    }
    @publish {
        method POST PUT
        path_regexp publish ^/([^/]+)?$
    }
    handle @publish {
        reverse_proxy ntfy:8080
    }
    handle {
        forward_auth auth:9091 {
            uri /api/authz/forward-auth?authelia_url=https://{$NTFY_DOMAIN}/auth/
        }
        reverse_proxy ntfy:8080 {
            flush_interval -1
        }
    }
}

uptime.144.24.135.201.sslip.io {
    import private_identity
    redir /return-to-dashboard https://{$DOMAIN}/dashboard/ 303
    # Keep the proxy's diagnostic endpoints private.
    @diagnostics path /ping /ready
    respond @diagnostics 404
    reverse_proxy kuma_sso:4180
}

# Internal health listener: port 8081 is NEVER published on a host.
# Return only explicit health endpoints, not a second application frontend.
http://:8081 {
    handle /app {
        rewrite * /api/contact
        reverse_proxy app:4173
    }
    handle /identity {
        rewrite * /auth/api/health
        reverse_proxy auth:9091
    }
    handle /notifications {
        rewrite * /v1/health
        reverse_proxy ntfy:8080
    }
    handle /containers {
        rewrite * /api/status
        reverse_proxy portainer:9000
    }
    respond 404
}

{$DOMAIN} {
    encode zstd gzip
    # Never accept identity claims supplied by a visitor.
    request_header -Remote-User
    request_header -Remote-Groups
    request_header -Remote-Email
    request_header -Remote-Name

    @login path /auth /auth/*
    handle @login {
        reverse_proxy auth:9091
    }

    @rakazoEntry path /rakazo /rakazo/
    redir @rakazoEntry https://rakazo.144.24.135.201.sslip.io/ 302

    @modelsEntry path /models /models/
    redir @modelsEntry https://models.144.24.135.201.sslip.io/ 302

    @notesEntry path /notes /notes/
    redir @notesEntry https://notes.144.24.135.201.sslip.io/ 302
    @uptimeEntry path /uptime /uptime/
    redir @uptimeEntry https://uptime.144.24.135.201.sslip.io/ 302
    @vaultEntry path /vault /vault/
    redir @vaultEntry https://vault.144.24.135.201.sslip.io/ 302

    redir /dashboard /dashboard/ 308
    @memberPages path /dashboard/ /dashboard/guide/
    handle @memberPages {
        forward_auth auth:9091 {
            uri /api/authz/forward-auth?authelia_url=https://{$DOMAIN}/auth/
            copy_headers Remote-User Remote-Groups
        }
        reverse_proxy access_console:8080
    }

    redir /admin/access /admin/access/ 308
    handle /admin/access/* {
        forward_auth auth:9091 {
            uri /api/authz/forward-auth?authelia_url=https://{$DOMAIN}/auth/
            copy_headers Remote-User Remote-Groups
        }
        reverse_proxy access_console:8080
    }

    @workspace path /admin /admin/*
    handle @workspace {
        forward_auth auth:9091 {
            uri /api/authz/forward-auth?authelia_url=https://{$DOMAIN}/auth/
            copy_headers Remote-User Remote-Groups Remote-Email Remote-Name
        }
        reverse_proxy app:4173 {
            header_up X-Real-IP {remote_host}
        }
    }

    redir /portainer /portainer/ 308
    # Portainer 2.45 requests translations at the host root even with --base-url.
    # Send them through the same protected route; do not expose a second proxy.
    @portainerTranslations path /locales/*/translation.json
    redir @portainerTranslations /portainer{uri} 307

    @containers path /portainer/*
    handle @containers {
        # Authorize the original URL before removing Portainer's path prefix.
        route {
            forward_auth auth:9091 {
                uri /api/authz/forward-auth?authelia_url=https://{$DOMAIN}/auth/
            }
            uri strip_prefix /portainer
            reverse_proxy portainer:9000
        }
    }

    # Retire the diagnostic endpoint without falling through to the portfolio.
    @retiredDemo path /node2 /node2/*
    respond @retiredDemo 404

    handle {
        reverse_proxy app:4173 {
            # Replace any visitor-supplied header with the real connected client.
            header_up X-Real-IP {remote_host}
        }
    }
}

notes.144.24.135.201.sslip.io {
    import private_identity
    # Outline revokes its session before navigating to its OIDC logout route.
    redir /auth/oidc.logout /oauth2/sign_out?rd=%2Freturn-to-dashboard 303
    redir /return-to-dashboard https://{$DOMAIN}/dashboard/ 303
    @privateEndpoints path /ready /ping /share /share/* /s /s/*
    respond @privateEndpoints 404
    reverse_proxy notes_sso:4180
}

vault.144.24.135.201.sslip.io {
    import private_identity
    redir /return-to-dashboard https://{$DOMAIN}/dashboard/ 303
    @privateEndpoints path /ready /ping /admin /admin/*
    respond @privateEndpoints 404
    reverse_proxy vault_sso:4180
}

models.144.24.135.201.sslip.io {
    import private_identity
    redir /return-to-dashboard https://{$DOMAIN}/dashboard/ 303
    @diagnostics path /ping /ready /healthz
    respond @diagnostics 404
    # Callback/logout routes terminate at the OIDC proxy, never at the app.
    handle /oauth2/* {
        reverse_proxy omniroute_sso:4180
    }
    handle {
        route {
            request_header -X-Models-Email
            reverse_proxy omniroute_sso:4180 {
                method GET
                rewrite /oauth2/auth?
                @authenticated status 2xx
                handle_response @authenticated {
                    route {
                        # Preserve the renewed browser ticket from the auth probe.
                        copy_response_headers {
                            include Set-Cookie
                        }
                        request_header X-Models-Email {rp.header.X-Auth-Request-Email}
                        forward_auth access_console:8080 {
                            uri /internal/authorize-models?
                        }
                        request_header -X-Models-Email
                        reverse_proxy omniroute_sso:4180
                    }
                }
                @unauthenticated status 401
                handle_response @unauthenticated {
                    reverse_proxy omniroute_sso:4180
                }
            }
        }
    }
}

# Keep the full workspace and offline desktop behind the same owner-only MFA gate.
rakazo.144.24.135.201.sslip.io {
    import private_identity
    @identity path /auth /auth/*
    handle @identity {
        reverse_proxy auth:9091
    }
    @privateDiagnostics path /healthz /health /ready /internal/*
    respond @privateDiagnostics 404
    handle {
        route {
            forward_auth auth:9091 {
                uri /api/authz/forward-auth?authelia_url=https://rakazo.144.24.135.201.sslip.io/auth/
                copy_headers Remote-User Remote-Groups
            }
            @owner {
                header Remote-User rithvik
                header_regexp Remote-Groups (^|,\s*)admins(\s*,|$)
            }
            handle @owner {
                redir /dashboard-exit https://rithvik.ddns.net/admin/ 302
                redir /computer /computer/ 302
                handle_path /computer/* {
                    reverse_proxy rakazo_pilot:8080
                }
                handle /api/* {
                    reverse_proxy rakazo_api:3100
                }
                handle {
                    reverse_proxy rakazo_web:5173
                }
            }
            respond "Owner access required" 403
        }
    }
}
