{
  "services": {
    "node2": {
      "image": "traefik/whoami@sha256:c4717a8d1f0134a7444e24f881160e033991f23027c6c5a9a3f8fd22e70d1d44",
      "networks": [
        "swarm_node2"
      ],
      "deploy": {
        "replicas": 1,
        "placement": {
          "constraints": [
            "node.labels.portfolio.worker == true"
          ]
        },
        "resources": {
          "limits": {
            "memory": "64M"
          }
        },
        "restart_policy": {
          "condition": "any",
          "delay": "5s"
        }
      },
      "read_only": true,
      "cap_drop": [
        "ALL"
      ]
    }
  },
  "networks": {
    "swarm_node2": {
      "driver": "overlay",
      "attachable": false
    }
  },
  "caddy_networks": [
    "swarm_node2"
  ],
  "configs": {},
  "secrets": {},
  "volumes": {},
  "http_checks": [
    {
      "url": "https://{DOMAIN}/node2/",
      "statuses": [
        302,
        303,
        401
      ]
    }
  ],
  "internal_checks": [
    "http://node2:80"
  ]
}
