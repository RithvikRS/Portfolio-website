        "--provider=oidc",
        "--oidc-issuer-url=https://rithvik.ddns.net/auth",
        "--client-id=portfolio-notes-edge",
        "--redirect-url=https://notes.144.24.135.201.sslip.io/oauth2/callback",
        "--code-challenge-method=S256",
        "--scope=openid profile email groups",
        "--email-domain=*",
        "--allowed-group=admins",
        "--upstream=http://outline:3000",
        "--skip-provider-button=true",
        "--cookie-name=__Host-notes_sso",
        "--cookie-secure=true",
        "--cookie-httponly=true",
        "--cookie-samesite=lax",
        "--cookie-expire=5m",
        "--session-cookie-minimal=true",
        "--pass-basic-auth=false",
        "--pass-user-headers=false",
        "--reverse-proxy=true",
        "--request-logging=false",
        "--allowed-group=notes"
      ],
      "networks": [
        "swarm_notes_edge",
        "swarm_notes_app"
      ],
      "secrets": [
        "notes_edge"
      ],
      "read_only": true,
      "cap_drop": [
        "ALL"
      ],
      "deploy": {
        "replicas": 1,
        "placement": {
          "constraints": [
            "node.role == worker",
            "node.labels.workload.compute == true",
            "node.id == tzqsl1t88r3l1i8zcqvcmredo"
          ]
        },
        "resources": {
          "limits": {
            "memory": "96M",
            "cpus": "0.50"
          }
        }
      }
    },
    "vault_sso": {
      "image": "quay.io/oauth2-proxy/oauth2-proxy:v7.15.6@sha256:c3415e8660af553f5e18f5d90db050614c02493c0ac6260ac59442f6d9b12048",
      "command": [
        "--config=/run/secrets/vault_edge",
        "--http-address=0.0.0.0:4180",
        "--provider=oidc",
        "--oidc-issuer-url=https://rithvik.ddns.net/auth",
        "--client-id=portfolio-vault-edge",
        "--redirect-url=https://vault.144.24.135.201.sslip.io/oauth2/callback",
        "--code-challenge-method=S256",
        "--scope=openid profile email groups",
        "--email-domain=*",
        "--allowed-group=admins",
        "--upstream=http://vaultwarden:80",
        "--skip-provider-button=true",
        "--cookie-name=__Host-vault_sso",
        "--cookie-secure=true",
        "--cookie-httponly=true",
        "--cookie-samesite=lax",
        "--cookie-expire=5m",
        "--session-cookie-minimal=true",
        "--pass-basic-auth=false",
        "--pass-user-headers=false",
        "--reverse-proxy=true",
        "--request-logging=false",
        "--allowed-group=vault"
      ],
      "networks": [
        "swarm_vault_edge",
        "swarm_vault_app"
      ],
      "secrets": [
        "vault_edge"
      ],
      "read_only": true,
      "cap_drop": [
        "ALL"
      ],
      "deploy": {
        "replicas": 1,
        "placement": {
          "constraints": [
            "node.role == worker",
            "node.labels.workload.compute == true",
            "node.id == tzqsl1t88r3l1i8zcqvcmredo"
          ]
        },
        "resources": {
          "limits": {
            "memory": "96M",
            "cpus": "0.50"
          }
        }
      }
    },
    "notes_db": {
      "image": "postgres:17-alpine@sha256:3540c0362c809df084ffac0ae69fe794515f9de92692f02178bcdce0ef0302ac",
      "networks": [
        "swarm_notes_data"
      ],
      "deploy": {
        "replicas": 1,
        "placement": {
          "constraints": [
            "node.id == tzqsl1t88r3l1i8zcqvcmredo"
          ]
        },
        "resources": {
          "limits": {
            "memory": "512M"
          }
        }
      },
      "logging": {
        "driver": "json-file",
        "options": {
          "max-size": "5m",
          "max-file": "2"
        }
      },
      "environment": {
        "POSTGRES_USER": "outline",
        "POSTGRES_DB": "outline",
        "POSTGRES_PASSWORD_FILE": "/run/secrets/notes_db_password"
      },
      "secrets": [
        "notes_db_password"
      ],
      "volumes": [
        {
          "type": "bind",
          "source": "/srv/swarm/notes_db",
          "target": "/var/lib/postgresql/data"
        }
      ],
      "healthcheck": {
        "test": [
          "CMD",
          "pg_isready",
          "-U",
          "outline"
        ],
        "interval": "20s",
        "timeout": "5s",
        "retries": 5
      }
    },
    "notes_cache": {
      "image": "redis:7-alpine@sha256:c5d34a98396a4775e223c74e929162c35c5a2182901ba26b50ade939941ce14b",
      "networks": [
        "swarm_notes_data"
      ],
      "deploy": {
        "replicas": 1,
        "placement": {
          "constraints": [
            "node.id == tzqsl1t88r3l1i8zcqvcmredo"
          ]
        },
        "resources": {
          "limits": {
            "memory": "160M"
          }
        }
      },
      "logging": {
        "driver": "json-file",
        "options": {
          "max-size": "5m",
          "max-file": "2"
        }
      },
      "command": [
        "redis-server",
        "--appendonly",
        "yes",
        "--maxmemory",
        "96mb",
        "--maxmemory-policy",
        "noeviction"
      ],
      "volumes": [
        {
          "type": "bind",
          "source": "/srv/swarm/notes_cache",
          "target": "/data"
        }
      ]
    },
    "outline": {
      "image": "docker.getoutline.com/outlinewiki/outline:1.12.0@sha256:25d6a2ced2f1f0cf03c09abd776d87ba31941ed96d3a99992aa84b3bd0afc074",
