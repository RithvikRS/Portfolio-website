{
  "services": {
    "uptime_kuma": {
      "image": "louislam/uptime-kuma:2.5.9@sha256:e88415a90dd2f7efecdbc18de0490aff292764a3ac471531bf1d0481725591bd",
      "user": "1000:1000",
      "networks": [
        "swarm_monitoring"
      ],
      "environment": {
        "UPTIME_KUMA_DB_TYPE": "sqlite",
        "NODE_OPTIONS": "--max-old-space-size=192"
      },
      "volumes": [
        {
          "type": "bind",
          "source": "/srv/swarm/uptime_kuma",
          "target": "/app/data"
        },
        {
          "type": "tmpfs",
          "target": "/tmp",
          "tmpfs": {
            "size": 33554432
          }
        }
      ],
      "read_only": true,
      "cap_drop": [
        "ALL"
      ],
      "stop_grace_period": "45s",
      "logging": {
        "driver": "json-file",
        "options": {
          "max-size": "10m",
          "max-file": "3"
        }
      },
      "deploy": {
        "replicas": 1,
        "placement": {
          "constraints": [
            "node.id == kxm75m17suc2o1hp0s4ikyhri"
          ]
        },
        "resources": {
          "limits": {
            "memory": "320M",
            "cpus": "0.50"
          },
          "reservations": {
            "memory": "128M"
          }
        },
        "update_config": {
          "parallelism": 1,
          "order": "stop-first",
          "failure_action": "pause",
          "monitor": "60s"
        },
        "rollback_config": {
          "parallelism": 1,
          "order": "stop-first",
          "monitor": "60s"
        }
      },
      "healthcheck": {
        "test": [
          "CMD",
          "extra/healthcheck"
        ],
        "interval": "30s",
        "timeout": "10s",
        "start_period": "90s",
        "retries": 3
      }
    },
    "kuma_sso": {
      "image": "quay.io/oauth2-proxy/oauth2-proxy:v7.15.6@sha256:c3415e8660af553f5e18f5d90db050614c02493c0ac6260ac59442f6d9b12048",
      "command": [
        "--config=/run/secrets/kuma_oidc",
        "--http-address=0.0.0.0:4180",
        "--provider=oidc",
        "--oidc-issuer-url=https://rithvik.ddns.net/auth",
        "--client-id=portfolio-kuma",
        "--redirect-url=https://uptime.144.24.135.201.sslip.io/oauth2/callback",
        "--code-challenge-method=S256",
        "--scope=openid profile email groups",
        "--email-domain=*",
        "--allowed-group=admins",
        "--upstream=http://uptime_kuma:3001",
        "--skip-provider-button=true",
        "--cookie-name=__Host-kuma_sso",
        "--cookie-secure=true",
        "--cookie-httponly=true",
        "--cookie-samesite=lax",
        "--cookie-expire=5m",
        "--session-cookie-minimal=true",
        "--pass-basic-auth=false",
        "--pass-user-headers=false",
        "--reverse-proxy=true",
        "--request-logging=false"
      ],
      "networks": [
        "swarm_monitoring"
      ],
      "secrets": [
        "kuma_oidc"
      ],
      "read_only": true,
      "cap_drop": [
        "ALL"
      ],
      "deploy": {
        "replicas": 1,
        "placement": {
          "constraints": [
            "node.role == worker",
            "node.labels.workload.compute == true",
            "node.id == tzqsl1t88r3l1i8zcqvcmredo"
          ]
        },
        "resources": {
          "limits": {
            "memory": "96M",
            "cpus": "0.50"
          }
        }
      }
    },
    "access_console": {
      "image": "python:3.13-alpine@sha256:1e1f6334529d1fb26a2ef619d7cffb30a7c7d7cc1cc7338ebee283a58d1aeaca",
      "networks": [
        "swarm_access"
      ],
      "deploy": {
        "replicas": 1,
        "placement": {
          "constraints": [
            "node.labels.portfolio.data == true"
          ]
        },
        "resources": {
          "limits": {
            "memory": "48M"
          }
        }
      },
      "logging": {
        "driver": "json-file",
        "options": {
          "max-size": "5m",
          "max-file": "2"
        }
      },
      "user": "1000:1000",
      "command": [
        "python",
        "-B",
        "/access-console.py"
      ],
      "configs": [
        {
          "source": "access_console",
          "target": "/access-console.py"
        }
      ],
      "volumes": [
        {
          "type": "bind",
          "source": "/opt/portfolio/.auth/secrets/directory",
          "target": "/directory"
        }
      ],
      "read_only": true,
      "cap_drop": [
        "ALL"
      ]
    },
    "notes_sso": {
      "image": "quay.io/oauth2-proxy/oauth2-proxy:v7.15.6@sha256:c3415e8660af553f5e18f5d90db050614c02493c0ac6260ac59442f6d9b12048",
      "command": [
