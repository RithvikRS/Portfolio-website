          ]
        },
        "resources": {
          "limits": {
            "memory": "1200M"
          }
        }
      },
      "logging": {
        "driver": "json-file",
        "options": {
          "max-size": "5m",
          "max-file": "2"
        }
      },
      "environment": {
        "NODE_ENV": "production",
        "URL": "https://notes.144.24.135.201.sslip.io",
        "PORT": "3000",
        "SECRET_KEY_FILE": "/run/secrets/outline_key",
        "UTILS_SECRET_FILE": "/run/secrets/outline_utils",
        "DATABASE_URL_FILE": "/run/secrets/outline_db_url",
        "PGSSLMODE": "disable",
        "REDIS_URL": "redis://notes_cache:6379",
        "OIDC_ISSUER_URL": "https://rithvik.ddns.net/auth",
        "OIDC_DISPLAY_NAME": "Authelia",
        "OIDC_DISABLE_REDIRECT": "true",
        "OIDC_CLIENT_ID": "portfolio-notes",
        "OIDC_CLIENT_SECRET_FILE": "/run/secrets/outline_client",
        "FILE_STORAGE": "local",
        "FILE_STORAGE_LOCAL_ROOT_DIR": "/var/lib/outline/data",
        "FILE_STORAGE_UPLOAD_MAX_SIZE": "26214400",
        "ENABLE_UPDATES": "false",
        "DEFAULT_LANGUAGE": "en_US"
      },
      "secrets": [
        "outline_key",
        "outline_utils",
        "outline_db_url",
        "outline_client"
      ],
      "volumes": [
        {
          "type": "bind",
          "source": "/srv/swarm/outline",
          "target": "/var/lib/outline/data"
        }
      ]
    },
    "vaultwarden": {
