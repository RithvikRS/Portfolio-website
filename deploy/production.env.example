# Copy to .env.production in the repository root. Never commit credentials.
# Use a domain only: no https:// prefix, path, or trailing slash.
DOMAIN=portfolio.example.com

# Leave SMTP fields empty until you are ready to enable message delivery.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
CONTACT_FROM=
CONTACT_TO=

# Change both together if this subnet overlaps another Docker/VPN network.
DOCKER_SUBNET=172.30.0.0/24
CADDY_IP=172.30.0.3
