+++ b/apps/api/src/workspace-only.test.ts
@@ -0,0 +1,83 @@
+import { describe, expect, it, vi } from "vitest";
+import { Hono } from "hono";
+import type { AgentRunRequest, BackgroundJob } from "@rakazo/adapter-kit";
+import { workspaceBotInputAllowed, disabledWorkspaceJobs, disabledWorkspaceRuntime, workspaceOwnerAllowed, workspaceOwnerEmail, workspaceRequestAllowed } from "./workspace-only.js";
+import { loadEnv } from "./env.js";
+
+const owner = "owner@example.test";
+const base = { DATABASE_URL: "postgres://test:test@localhost/test", NODE_ENV: "test" };
+
+describe("workspace-only deployment boundary", () => {
+  it("allows inert profiles but rejects automation and model configuration", () => {
+    expect(workspaceBotInputAllowed({ name: "Draft", instructions: "Plan later", dailyCheckIns: false, fleetManagement: false })).toBe(true);
+    for (const input of [{dailyCheckIns:true}, {fleetManagement:true}, {autoSpeak:true}, {modelProvider:"test",modelId:"test"}, {teamChatRules:"run"}, {disabledBuiltinTools:[]}]) {
+      expect(workspaceBotInputAllowed(input)).toBe(false);
+    }
+    expect(workspaceRequestAllowed("POST", "/rpc/bots/duplicate")).toBe(false);
+  });
+  it("is opt-in, validates its flag, requires one exact owner, and disables device access", () => {
+    expect(loadEnv(base).workspaceOnly).toBe(false);
+    expect(() => loadEnv({ ...base, WORKSPACE_ONLY: "1" })).toThrow("WORKSPACE_ONLY");
+    expect(() => loadEnv({ ...base, WORKSPACE_ONLY: "true" })).toThrow("SIGNUP_ALLOWLIST");
+    const env = loadEnv({ ...base, WORKSPACE_ONLY: "true", SIGNUP_ALLOWLIST: owner, USER_DEVICES_ENABLED: "true", SANDBOX_PROVIDER: "docker", CLOUD_AGENT_PROVIDER: "emulator" });
+    expect(env.workspaceOnly).toBe(true);
+    expect(env.workspaceOwnerEmail).toBe(owner);
+    expect(env.userDevicesEnabled).toBe(false);
+    expect(env.sandboxProvider).toBe("none");
+    expect(env.cloudAgentProvider).toBe("none");
+    for (const value of ["@example.test", "first@example.test,second@example.test", "", "not-email"]) {
+      expect(() => workspaceOwnerEmail(true, value)).toThrow();
+    }
+  });
+  it("requires the admitted owner's currently verified email for native app requests", () => {
+    expect(workspaceOwnerAllowed(owner, { email: owner, emailVerified: true })).toBe(true);
+    expect(workspaceOwnerAllowed(owner, { email: owner, emailVerified: false })).toBe(false);
+    expect(workspaceOwnerAllowed(owner, { email: "other@example.test", emailVerified: true })).toBe(false);
+  });
+  it.each(["spaces/create", "spaces/rename", "spaces/remove", "organizations/create", "bots/create", "bots/update", "scratchpad/create", "threads/messages"])("keeps reviewed workspace operation %s available", path => {
+    expect(workspaceRequestAllowed("POST", "/rpc/" + path)).toBe(true);
+  });
+  it.each([
+    "/rpc/models/connect", "/rpc/models/probeOpenAiCompatible", "/rpc/models/probeCatalog", "/rpc/models/beginOAuth", "/rpc/models/completeOAuth",
+    "/rpc/threads/send", "/rpc/threads/sendWithRoutines", "/rpc/threads/followUp", "/rpc/threads/answer",
+    "/rpc/routines/create", "/rpc/routines/update", "/rpc/routines/run", "/rpc/connections/begin", "/rpc/mcp/add", "/rpc/memory/connectProvider",
+    "/rpc/voice/connect", "/rpc/voice/prepare", "/rpc/computer/start", "/rpc/computerProvider/configure", "/rpc/bots/importCreate", "/rpc/onboarding/start",
+    "/rpc", "/rpc/batch", "/rpc/spaces/create/extra", "/rpc/spaces%2fcreate", "/rpc/spaces/create%00", "/rpc//spaces/create",
+    "/api/account/import", "/api/v1/bots/example/webhook", "/api/v1/phone/inbound", "/api/devices/connect", "/api/voice/transcribe", "/novnc/session/control/example",
+    "/api/auth/sign-up/email", "/api/auth/sign-in/email", "/api/auth/update-user", "/api/auth/link-social", "/api/auth/organization/invite-member",
+  ])("denies %s before handlers, including future methods and alternate protocols", async path => {
+    const reached = vi.fn();
+    const app = new Hono();
+    app.use("*", async (c, next) => {
+      if (!workspaceRequestAllowed(c.req.method, c.req.path)) return c.text("disabled", 403);
+      return next();
+    });
+    app.all("*", c => { reached(); return c.text("unexpected"); });
+    expect((await app.request(path, { method: "POST", body: "{}" })).status).toBe(403);
+    expect(reached).not.toHaveBeenCalled();
+  });
+  it("keeps only the necessary OIDC/session paths and rejects other methods", () => {
+    expect(workspaceRequestAllowed("POST", "/api/auth/sign-in/social")).toBe(true);
+    expect(workspaceRequestAllowed("POST", "/api/auth/sign-in/oauth2")).toBe(true);
+    expect(workspaceRequestAllowed("GET", "/api/auth/callback/oidc")).toBe(true);
+    expect(workspaceRequestAllowed("GET", "/api/auth/get-session")).toBe(true);
+    expect(workspaceRequestAllowed("POST", "/api/auth/sign-out")).toBe(true);
+    for (const method of ["PUT", "DELETE", "PATCH", "CONNECT", "TRACE"]) {
+      expect(workspaceRequestAllowed(method, "/rpc/spaces/create")).toBe(false);
+    }
+  });
+  it("refuses every background job instead of leaving work queued for a later worker", async () => {
+    const jobs = disabledWorkspaceJobs();
+    for (const name of ["run.continue", "routine.execute", "computer.resume", "anything-new"]) {
+      await expect(jobs.enqueue({ name, payload: {} } as BackgroundJob)).rejects.toThrow("disabled");
+    }
+    await jobs.cancel("run:test");
+    await jobs.close();
+  });
+  it("refuses the runtime itself even if called outside the HTTP dispatcher", async () => {
+    const runtime = disabledWorkspaceRuntime();
+    expect(runtime.describe().capabilities.tools).toBe(false);
+    const events = runtime.run({ runId: "test", prompt: "do work" } as AgentRunRequest);
+    await expect(events[Symbol.asyncIterator]().next()).rejects.toThrow("disabled");
+  });
+});
diff --git a/apps/api/src/workspace-only.ts b/apps/api/src/workspace-only.ts
new file mode 100644
index 0000000..1a5ce94
--- /dev/null
+++ b/apps/api/src/workspace-only.ts
@@ -0,0 +1,77 @@
+import type { AgentRuntime, JobPublisher } from "@rakazo/adapter-kit";
+
+export const WORKSPACE_ONLY_MESSAGE = "Model connections and agent execution are disabled on this deployment.";
+
+// Exact procedures, not prefixes: future methods stay closed until reviewed.
+const RPC = new Set([
+  "health", "me",
+  "spaces/list", "spaces/create", "spaces/rename", "spaces/remove",
+  "organizations/list", "organizations/create", "organizations/rename", "organizations/remove",
+  "bots/list", "bots/listArchived", "bots/get", "bots/create", "bots/reorder",
+  "bots/update", "bots/restoreInstructions", "bots/archive", "bots/restore", "bots/remove",
+  "groups/list", "groups/listArchived", "groups/get", "groups/create", "groups/duplicate",
+  "groups/update", "groups/archive", "groups/restore", "groups/remove",
+  "botSections/list", "botSections/create", "botSections/update", "botSections/remove",
+  "threads/head", "threads/get", "threads/messages", "threads/subscribe", "threads/markRead", "threads/markUnread",
+  "preferences/update", "preferences/adoptTimezone", "notifications/subscribe",
+  "models/list", "models/credentials", "routines/list",
+  "pages/list", "pages/get", "pages/rename", "pages/pin", "pages/remove",
+  "artifacts/list", "artifacts/listSpace", "artifacts/listVersions", "artifacts/get", "artifacts/getById", "artifacts/remove",
+  "search/query", "runs/list", "usage/list", "usage/summary", "spaceSettings/overrides",
+  "availability/items", "agentSkills/list", "agentSkills/get", "memory/list", "memory/budget",
+  "scratchpad/list", "scratchpad/create", "scratchpad/update", "scratchpad/remove",
+]);
+const AUTH_GET = new Set([
+  "/api/auth/capabilities", "/api/auth/get-session", "/api/auth/list-sessions",
+  "/api/auth/list-accounts", "/api/auth/account-security", "/api/auth/callback/oidc",
+]);
+const AUTH_POST = new Set([
+  "/api/auth/sign-in/social", "/api/auth/sign-in/oauth2", "/api/auth/callback/oidc", "/api/auth/sign-out",
+  "/api/auth/revoke-session", "/api/auth/revoke-sessions", "/api/auth/revoke-other-sessions",
+]);
+
+export function workspaceRequestAllowed(method: string, path: string): boolean {
+  if (path.includes("%") || path.includes("\\") || path.includes("//")) return false;
+  if (method === "GET" && ["/health", "/ready", "/internal/health"].includes(path)) return true;
+  if (method === "GET" && AUTH_GET.has(path)) return true;
+  if (method === "POST" && AUTH_POST.has(path)) return true;
+  return ["GET", "POST"].includes(method) && path.startsWith("/rpc/") && RPC.has(path.slice(5));
+}
+
+export function workspaceOwnerEmail(enabled: boolean, allowlist: string | undefined): string | undefined {
+  if (!enabled) return undefined;
+  const value = allowlist?.trim().toLowerCase();
+  if (!value || !/^[^@\s,]+@[^@\s,]+\.[^@\s,]+$/.test(value)) {
+    throw new Error("WORKSPACE_ONLY requires SIGNUP_ALLOWLIST to contain exactly one owner email");
+  }
+  return value;
+}
+
+export function workspaceOwnerAllowed(owner: string | undefined, user: { email: string; emailVerified: boolean }): boolean {
+  return owner === undefined || (user.emailVerified === true && user.email.toLowerCase() === owner);
+}
+
+// Never publish a deferred job that could run when a worker is later introduced.
+export function disabledWorkspaceJobs(): JobPublisher {
+  return {
+    async enqueue() { throw new Error(WORKSPACE_ONLY_MESSAGE); },
+    async cancel() {},
+    async close() {},
+  };
+}
+
+export function disabledWorkspaceRuntime(): AgentRuntime {
+  return {
+    describe: () => ({ id: "workspace-only", contractVersion: "1", adapterVersion: "1",
+      capabilities: { streaming: false, compaction: false, tools: false, scripted: false } }),
+    async *run() { throw new Error(WORKSPACE_ONLY_MESSAGE); },
+    async abort() {},
+  };
+}
+
+// Profile edits remain local; no dormant automation or model configuration is accepted.
+export function workspaceBotInputAllowed(input: Record<string, unknown>): boolean {
+  const disabled = ["dailyCheckIns", "fleetManagement", "autoSpeak", "teamChatAmbientEnabled", "crossSpaceCommunication"];
