+export function nativeRouterQuota(error: unknown): string | undefined {
+ if(typeof error!=='string'||error.length>8192)return;
+ if(error==='The model hit its output limit before writing a response.')return 'The free provider reached its output limit before returning an answer. Auto adds no token allowance. Try a smaller step or retry when another free provider is available.';
+ const json=error.replace(/^(?:401|403|413|429|500|502|503|504)\s*:\s*/, '');
+ const prefixes:Record<string,string>={assistant_task_failed:'The assistant task was interrupted.',free_pool_quota:'Free-only routing reached a provider or account quota.',free_pool_context:'Free providers rejected this request as too large.',free_pool_access:'Free-only routing refused this request.',free_pool_unavailable:'The free model pool is temporarily unavailable.',free_access_revoked:'Assistant access is disabled or unavailable.',token_limit_exceeded:'Rakazo daily token quota reached',run_model_limit:'Run model-call limit reached',daily_run_limit:'Daily assistant task limit reached',daily_call_limit:'Daily model-call quota reached',request_rate_limit:'Assistant request quota reached'};
+ try{const p=JSON.parse(json);if(Object.hasOwn(prefixes,p.code)&&typeof p.message==='string'&&p.message.startsWith(prefixes[p.code])&&p.message.length<=700)return p.message;}catch{}
+}
