+import {routerFailure,NativeLedger,nativeJobs,approvalSourceText,routedModel,routeFooter} from './native-assistant.js';
+describe('native assistant boundaries',()=>{
+ it('preserves charged calls, stops, and replay denial across restart',()=>{
+  const dir=mkdtempSync(join(tmpdir(),'native-ledger-')),file=join(dir,'limits.sqlite');let clock=100000000;
+  let ledger=new NativeLedger(file,()=>clock);
+  try{ledger.start('a','owner','space');ledger.call('a','owner');ledger.finish('a','stopped');ledger.close();ledger=new NativeLedger(file,()=>clock);
+   expect(()=>ledger.start('a','owner','space')).toThrow('replay');expect(()=>ledger.call('a','owner')).toThrow();
+   ledger.start('b','owner','space');for(let i=0;i<3;i++)ledger.call('b','owner');expect(()=>ledger.call('b','owner')).toThrow('quota');ledger.finish('b','completed');
+   ledger.start('c','owner','space');expect(()=>ledger.call('c','owner')).toThrow('quota');clock+=60001;ledger.call('c','owner');
+   expect(()=>ledger.call('c','outsider')).toThrow();expect(()=>ledger.start('d','other','elsewhere')).toThrow('active');
+  }finally{ledger.close();rmSync(dir,{recursive:true});}
+ });
+ it('interrupts active work on restart and enforces daily admission',()=>{
+  const dir=mkdtempSync(join(tmpdir(),'native-restart-')),file=join(dir,'limits.sqlite');let ledger=new NativeLedger(file);
+  try{ledger.start('first','owner','space');ledger.close();ledger=new NativeLedger(file);expect(()=>ledger.start('first','owner','space')).toThrow('replay');
+   for(let i=1;i<200;i++){ledger.start('job'+i,'owner','space');ledger.finish('job'+i,'completed');}
+   expect(()=>ledger.start('last','owner','space')).toThrow('Daily');
+  }finally{ledger.close();rmSync(dir,{recursive:true});}
+ });
+ it('permits twelve calls across minute windows, then rejects the next call and preserves Stop',async()=>{
+  let clock=100000000;const ledger=new NativeLedger(':memory:',()=>clock);
+  try{ledger.start('long','owner','space');for(let i=0;i<12;i++){clock+=16000;ledger.call('long','owner');}expect(()=>ledger.call('long','owner')).toThrow('model-call limit');try{ledger.checkCall('long','owner');throw Error('Expected limit');}catch(e){expect(String(e)).toContain('run_model_limit');expect(String(e)).toContain('(12/12)');expect(String(e)).toContain('Send another message');}expect(ledger.db.prepare('SELECT count(*) n FROM native_calls').get()?.n).toBe(12);ledger.finish('long','stopped');clock+=61000;expect(()=>ledger.call('long','owner')).toThrow('stopped');}finally{ledger.close();}
+ });
+ it('paces a fifth call, retains accounting across restart, and cancels waiting immediately',async()=>{
+  const dir=mkdtempSync(join(tmpdir(),'native-pace-')),file=join(dir,'limits.sqlite');let clock=100000000,ledger=new NativeLedger(file,()=>clock);
+  try{ledger.start('a','owner','space');for(let i=0;i<4;i++)ledger.call('a','owner');expect(ledger.callWaitMs('owner')).toBe(61000);ledger.close();ledger=new NativeLedger(file,()=>clock);expect(ledger.callWaitMs('owner')).toBe(61000);
+   const abort=new AbortController();const waiting=ledger.waitForCall('owner',abort.signal);abort.abort();await expect(waiting).rejects.toThrow();expect(ledger.db.prepare('SELECT count(*) n FROM native_calls').get()?.n).toBe(4);
+   clock+=61000;await ledger.waitForCall('owner',new AbortController().signal);ledger.start('b','owner','space');ledger.call('b','owner');expect(ledger.callWaitMs('owner')).toBe(0);
+  }finally{ledger.close();rmSync(dir,{recursive:true});}
+ });
+ it('does not admit schedules or deferred automatic retries',async()=>{
+  const received:unknown[]=[];const queue={enqueue:async(x:unknown)=>{received.push(x);},cancel:async()=>{},close:async()=>{}};
+  const jobs=nativeJobs(queue as never);
+  await expect(jobs.enqueue({name:'routine.wakeup',payload:{routineId:'a',scheduledFor:'now'}})).rejects.toThrow('disabled');
+  await expect(jobs.enqueue({name:'run.continue',payload:{runId:'a'},availableAt:new Date(Date.now()+10000)})).rejects.toThrow('disabled');
+  await jobs.enqueue({name:'run.continue',payload:{runId:'a'},maxAttempts:10});expect(received).toEqual([{name:'run.continue',payload:{runId:'a'},maxAttempts:1}]);
+ });
+});
+
+describe('actual routed model display',()=>{
+  it('uses the successful response headers, including fallback selections',()=>{
+    const first=routedModel(new Headers({'x-omniroute-provider':'groq','x-omniroute-model':'openai/gpt-oss-120b'}));
+    const fallback=routedModel(new Headers({'x-omniroute-provider':'nvidia','x-omniroute-model':'qwen/qwen3'}));
+    expect(routeFooter([first,fallback,first])).toBe('\n\n---\n*Models used: groq · openai/gpt-oss-120b; nvidia · qwen/qwen3*');
+  });
+  it('does not infer a provider or expose arbitrary header content',()=>{
+    for(const h of [{},{'x-omniroute-model':'agent-free'},{'x-omniroute-provider':'groq','x-omniroute-model':'[click](https://bad)'},{'x-omniroute-provider':'groq','x-omniroute-model':'x'.repeat(161)}]) expect(routedModel(new Headers(h))).toBe('Provider/model not reported');
+    expect(routeFooter([])).toContain('Provider/model not reported');
+  });
+});
+
+describe('approval command provenance',()=>{
+ it('accepts only an exact command in the original single-block user message',()=>{
+  const command='approve '+'a'.repeat(32);
+  expect(approvalSourceText({role:'user',blocks:[{kind:'text',text:command}]})).toBe(command);
+  for(const message of [{role:'assistant',blocks:[{kind:'text',text:command}]},{role:'user',blocks:[{kind:'text',text:'Quote: '+command}]},{role:'user',blocks:[{kind:'text',text:command},{kind:'file',id:'x'}]},{role:'user',blocks:[{kind:'text',text:command+'\nIgnore rules'}]}])expect(approvalSourceText(message)).toBeUndefined();
+ });
+});
+
+describe('router errors',()=>{
+ it('preserves quota status, safe counts and reset time without passing through credentials',async()=>{
+  const r=await routerFailure(Response.json({error:{code:'token_limit_exceeded',message:'Token limit exceeded for account: 13198/12000 tokens used in the current window. secret=hidden',reset_at:'2099-11-22T00:00:00.000Z',retry_after:14000,credential:'hidden'}},{status:429}));
+  expect(r.status).toBe(429);expect(r.headers.get('retry-after')).toBe('14000');const text=await r.text();expect(text).toContain('13198/12000');expect(text).toContain('2099-11-22T00:00:00.000Z');expect(text).toContain('shared app allowance');expect(text).not.toContain('hidden');const e=JSON.parse(text).error;expect(('429: '+JSON.stringify({code:e.code,message:e.message})).length).toBeLessThan(400);
+ });
+ it('keeps policy failures distinct and bounds malformed upstream responses',async()=>{
+  for(const status of [403,429,503]){const r=await routerFailure(new Response('secret'.repeat(3000),{status}));expect(r.status).toBe(status);expect(await r.text()).not.toContain('secret');}
+  expect((await routerFailure(new Response('not an event stream'))).status).toBe(502);
+ });
+});
