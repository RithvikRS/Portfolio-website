@@ -0,0 +1,6 @@
+export function nativeRouterQuota(error: unknown): string | undefined {
+ if(typeof error!=='string'||error.length>8192)return;
+ const json=error.replace(/^429\s*:\s*/, '');
+ const prefixes:Record<string,string>={token_limit_exceeded:'Rakazo daily token quota reached',run_model_limit:'Run model-call limit reached',daily_run_limit:'Daily assistant task limit reached',daily_call_limit:'Daily model-call quota reached',request_rate_limit:'Assistant request quota reached'};
+ try{const p=JSON.parse(json);if(Object.hasOwn(prefixes,p.code)&&typeof p.message==='string'&&p.message.startsWith(prefixes[p.code])&&p.message.length<=700)return p.message;}catch{}
+}
