+    if(Number(count.n)>=nativeLimits.dailyCalls)throw localLimitError('daily_call_limit',`Daily model-call quota reached (${nativeLimits.dailyCalls}/${nativeLimits.dailyCalls}). Resets at 05:30 Asia/Kolkata.`);
