+++ b/apps/api/src/native-assistant.test.ts
@@ -0,0 +1,31 @@
+import {describe,it,expect} from 'vitest';
+import {mkdtempSync,rmSync} from 'node:fs';
+import {tmpdir} from 'node:os';
+import {join} from 'node:path';
+import {NativeLedger,nativeJobs} from './native-assistant.js';
+describe('native assistant boundaries',()=>{
+ it('preserves charged calls, stops, and replay denial across restart',()=>{
+  const dir=mkdtempSync(join(tmpdir(),'native-ledger-')),file=join(dir,'limits.sqlite');let clock=100000000;
+  let ledger=new NativeLedger(file,()=>clock);
+  try{ledger.start('a','owner','space');ledger.call('a','owner');ledger.finish('a','stopped');ledger.close();ledger=new NativeLedger(file,()=>clock);
+   expect(()=>ledger.start('a','owner','space')).toThrow('replay');expect(()=>ledger.call('a','owner')).toThrow();
+   ledger.start('b','owner','space');for(let i=0;i<3;i++)ledger.call('b','owner');expect(()=>ledger.call('b','owner')).toThrow();ledger.finish('b','completed');
+   ledger.start('c','owner','space');expect(()=>ledger.call('c','owner')).toThrow('quota');clock+=60001;ledger.call('c','owner');
+   expect(()=>ledger.call('c','outsider')).toThrow();expect(()=>ledger.start('d','other','elsewhere')).toThrow('active');
+  }finally{ledger.close();rmSync(dir,{recursive:true});}
+ });
+ it('interrupts active work on restart and enforces daily admission',()=>{
+  const dir=mkdtempSync(join(tmpdir(),'native-restart-')),file=join(dir,'limits.sqlite');let ledger=new NativeLedger(file);
+  try{ledger.start('first','owner','space');ledger.close();ledger=new NativeLedger(file);expect(()=>ledger.start('first','owner','space')).toThrow('replay');
+   for(let i=1;i<20;i++){ledger.start('job'+i,'owner','space');ledger.finish('job'+i,'completed');}
+   expect(()=>ledger.start('last','owner','space')).toThrow('Daily');
+  }finally{ledger.close();rmSync(dir,{recursive:true});}
+ });
+ it('does not admit schedules or deferred automatic retries',async()=>{
+  const received:unknown[]=[];const queue={enqueue:async(x:unknown)=>{received.push(x);},cancel:async()=>{},close:async()=>{}};
+  const jobs=nativeJobs(queue as never);
+  await expect(jobs.enqueue({name:'routine.wakeup',payload:{routineId:'a',scheduledFor:'now'}})).rejects.toThrow('disabled');
+  await expect(jobs.enqueue({name:'run.continue',payload:{runId:'a'},availableAt:new Date(Date.now()+10000)})).rejects.toThrow('disabled');
+  await jobs.enqueue({name:'run.continue',payload:{runId:'a'},maxAttempts:10});expect(received).toEqual([{name:'run.continue',payload:{runId:'a'},maxAttempts:1}]);
+ });
+});
